# Copy to .env.local for development. Never commit real inboxes or credentials.
# Start with: uvicorn index:app --reload --port 8000 --env-file .env.local
CONTACT_TO_EMAIL=your-private-inbox@example.com
CONTACT_FROM_EMAIL=your-sending-account@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=your-sending-account@example.com
# Gmail requires an app password for this setup; do not use your normal password.
SMTP_PASSWORD=
